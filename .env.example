# ============================================
# S14 Partner Metrics Service Configuration
# ============================================

# Partner Configuration
# ---------------------
# The unique identifier for this partner instance
PARTNER_ID=partner_abc123

# Flask HTTP Server Configuration
# --------------------------------
# Host to bind the Flask server to (0.0.0.0 for all interfaces)
FLASK_HOST=0.0.0.0

# Port to bind the Flask server to
FLASK_PORT=5014

# Enable Flask debug mode (True/False)
FLASK_DEBUG=False

# CORS Configuration
# ------------------
# Allowed origins for CORS (comma-separated list)
# Use * to allow all origins (not recommended for production)
# Example: http://localhost:3000,https://partner-portal.example.com
CORS_ALLOWED_ORIGINS=*

# RabbitMQ Configuration
# ----------------------
# RabbitMQ connection URL
# Format: amqp://username:password@host:port/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# RabbitMQ Queue Names
# --------------------
# Queue name for receiving events from S08 Core Metrics Service
S08_EVENTS_QUEUE=s08_events_queue

# Queue name for sending method requests to S08 Core Metrics Service
S14_S08_REQUESTS_QUEUE=s14_s08_requests_queue

# Queue name for receiving method responses from S08 Core Metrics Service
S14_S08_RESPONSES_QUEUE=s14_s08_responses_queue

# Authentication Configuration (JWT/JWKS)
# ----------------------------------------
# Base URL of the Identity Service for JWT verification
# This service will fetch JWKS from {IDENTITY_SERVICE_URL}/.well-known/jwks.json
IDENTITY_SERVICE_URL=http://localhost:5001

# TTL (Time To Live) for cached JWKS in minutes
# The service will refresh JWKS from Identity Service at this interval
JWKS_TTL_IN_MINUTES=10

# S08 Core Metrics Service Configuration
# ---------------------------------------
# Base URL for S08 Core Metrics Service (if HTTP APIs are needed)
# Note: Currently all communication with S08 is via RabbitMQ
S08_CORE_METRICS_SERVICE_URL=http://localhost:5008

# Logging Configuration
# ---------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
